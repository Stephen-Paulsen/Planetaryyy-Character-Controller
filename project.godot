[input_devices]

joypads/ignore_joypad_on_unfocused_application=true

[layer_names]

3d_render/layer_1="SolidSurface"
3d_physics/layer_1="SolidSurface"
3d_physics/layer_2="PlayerCharacter"
3d_physics/layer_3="PhysicsObject"
3d_physics/layer_4="EnemyCharacter"
3d_physics/layer_5="Projectile"
3d_physics/layer_6="EnvironmentArea "

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="Jolt Physics"
3d/default_gravity=0.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.0

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/multi_bounce_occlusion/enabled=true
